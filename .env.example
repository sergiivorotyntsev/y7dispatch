# =============================================================================
# Vehicle Transport Automation (y7dispatch) - Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
DATABASE_PATH=data/control_panel.db
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -----------------------------------------------------------------------------
# Authentication (REQUIRED for production — without these, auth is disabled)
# -----------------------------------------------------------------------------
# Generate credentials: python scripts/setup_auth.py
AUTH_USERNAME=sergii
AUTH_PASSWORD_HASH=              # bcrypt hash — generate with setup_auth.py
JWT_SECRET=                      # 64-char hex — generate with setup_auth.py
JWT_EXPIRE_HOURS=24
COOKIE_SECURE=true               # Set to false for local dev (http, not https)

# -----------------------------------------------------------------------------
# CORS (restrict to your domain in production)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Email Configuration (credentials stored via Settings UI > Credentials)
# -----------------------------------------------------------------------------
# Provider: "imap" for standard IMAP, "oauth2" for Microsoft 365
# Email credentials are managed via the Credentials page in the UI
# and stored encrypted in the credential_store table.
# These env vars are ONLY needed if not using the UI credential store:
# EMAIL_IMAP_SERVER=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_ADDRESS=info@y7agency.com
# EMAIL_PASSWORD=your-app-password-here

# Microsoft 365 / OAuth2 (if not using credential store)
# EMAIL_TENANT_ID=your-tenant-id
# EMAIL_CLIENT_ID=your-client-id
# EMAIL_CLIENT_SECRET=your-client-secret

# -----------------------------------------------------------------------------
# Auto-Polling (background, processes only NEW emails not in email_log)
# -----------------------------------------------------------------------------
# Poll settings are managed via config/poll_settings.json and the Settings UI.
# No env vars needed for polling configuration.

# -----------------------------------------------------------------------------
# Claude AI Extraction
# -----------------------------------------------------------------------------
# Model is hardcoded in services/haiku_extractor.py (claude-haiku-4-5-20251001)

# -----------------------------------------------------------------------------
# Central Dispatch API
# -----------------------------------------------------------------------------
CD_ENABLED=false
CD_CLIENT_ID=your-client-id
CD_CLIENT_SECRET=your-client-secret
CD_MARKETPLACE_ID=10000
# CD_API_URL=https://api.centraldispatch.com

# -----------------------------------------------------------------------------
# Google Maps Distance (optional — falls back to OSRM then haversine)
# -----------------------------------------------------------------------------
# Stored via credential_store (Settings > Credentials), or set here:
# GOOGLE_MAPS_API_KEY=your-api-key

# -----------------------------------------------------------------------------
# Google Sheets Integration (optional)
# -----------------------------------------------------------------------------
SHEETS_ENABLED=false
# SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# SHEETS_CREDENTIALS_FILE=credentials.json

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text

# Temp directory for PDF processing
TEMP_DIR=/tmp/dispatch
